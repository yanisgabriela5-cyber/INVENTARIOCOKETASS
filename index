<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Toma de inventario por zonas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<meta name="theme-color" content="#C2185B">
<style>
:root{
  --bg:#F3F4F7; --surface:#FFFFFF; --ink:#1C2030; --muted:#5B6275; --line:#D9DCE5;
  --accent:#C2185B; --accent-ink:#FFFFFF; --accent-soft:#FBE3EC;
  --ok:#17784A; --ok-soft:#DDF3E7; --warn:#A35A00; --warn-soft:#FFF0D6; --bad:#B42318; --bad-soft:#FDE4E1;
  --font:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#13151C; --surface:#1D2029; --ink:#ECEEF4; --muted:#A3A9BA; --line:#323746;
    --accent:#F06292; --accent-ink:#1A0A11; --accent-soft:#3A1A27;
    --ok:#5BD69A; --ok-soft:#163327; --warn:#F5B24E; --warn-soft:#3A2A12; --bad:#FF8A80; --bad-soft:#3D1D1B;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#13151C; --surface:#1D2029; --ink:#ECEEF4; --muted:#A3A9BA; --line:#323746;
  --accent:#F06292; --accent-ink:#1A0A11; --accent-soft:#3A1A27;
  --ok:#5BD69A; --ok-soft:#163327; --warn:#F5B24E; --warn-soft:#3A2A12; --bad:#FF8A80; --bad-soft:#3D1D1B;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.4;-webkit-tap-highlight-color:transparent}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:640px;margin:0 auto;padding:0 12px 96px}

header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.top-in{max-width:640px;margin:0 auto;padding:10px 12px;display:flex;align-items:center;gap:10px}
.zone-btn{flex:1;min-width:0;display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:12px;border:2px solid var(--accent);background:var(--accent-soft);cursor:pointer;text-align:left}
.zone-btn small{display:block;color:var(--muted);font-size:13px}
.zone-btn strong{display:block;font-size:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.zone-btn .chev{margin-left:auto;font-size:20px;color:var(--accent)}
.status{font-size:13px;color:var(--muted);text-align:right;max-width:40%}
.status .dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--muted);margin-right:5px;vertical-align:middle}
.status.on .dot{background:var(--ok)} .status.off .dot{background:var(--bad)}

.banner{margin:12px 0 0;padding:10px 12px;border-radius:10px;font-size:15px}
.banner.warn{background:var(--warn-soft);color:var(--warn)} .banner.bad{background:var(--bad-soft);color:var(--bad)}
.hidden{display:none!important}

.scan{margin-top:14px}
.scan label{display:block;font-weight:700;margin-bottom:6px}
.field{width:100%;font-size:24px;padding:14px;border-radius:12px;border:2px solid var(--line);background:var(--surface);letter-spacing:.02em}
.field:focus{border-color:var(--accent);outline:none}
.hint{color:var(--muted);font-size:14px;margin-top:6px}

.item{margin-top:14px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px}
.item.nf{border-color:var(--warn);background:var(--warn-soft)}
.item .code{font-size:15px;color:var(--muted);word-break:break-all}
.item .desc{font-size:21px;font-weight:700;margin:2px 0 6px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:14px;padding:3px 9px;border-radius:999px;background:var(--bg);border:1px solid var(--line)}
.prev{margin-top:8px;font-size:15px;color:var(--muted)}
.prev b{color:var(--ink)}
.qty-row{display:flex;gap:8px;margin-top:12px;align-items:stretch}
.qty-row .step{width:62px;font-size:28px;border-radius:12px;border:2px solid var(--line);background:var(--bg);cursor:pointer}
.qty-row input{flex:1;text-align:center;font-size:30px;font-weight:700;min-width:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:0 18px;border-radius:12px;border:2px solid transparent;cursor:pointer;font-weight:700;font-size:18px}
.btn.primary{background:var(--accent);color:var(--accent-ink);width:100%;margin-top:10px;min-height:58px;font-size:20px}
.btn.ghost{background:transparent;border-color:var(--line)}
.btn.danger{background:var(--bad-soft);color:var(--bad)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.flash{margin-top:12px;padding:12px;border-radius:12px;font-size:17px;font-weight:700}
.flash.ok{background:var(--ok-soft);color:var(--ok)} .flash.bad{background:var(--bad-soft);color:var(--bad)}

h2{font-size:19px;margin:24px 0 8px}
.list{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.row{display:flex;align-items:center;gap:10px;padding:11px 12px;border-top:1px solid var(--line);width:100%;background:none;border-left:0;border-right:0;border-bottom:0;text-align:left;cursor:pointer}
.row:first-child{border-top:0}
.row .main{flex:1;min-width:0}
.row .t1{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .t2{font-size:14px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .q{font-size:22px;font-weight:700;min-width:44px;text-align:right}
.row.pending .q{color:var(--warn)}
.empty{padding:18px 12px;color:var(--muted);font-size:15px}

.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:14px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.stat b{display:block;font-size:26px}
.stat span{font-size:14px;color:var(--muted)}
.zone-table{width:100%;border-collapse:collapse;font-size:16px}
.zone-table td,.zone-table th{padding:9px 12px;border-top:1px solid var(--line);text-align:left}
.zone-table th{font-size:14px;color:var(--muted);font-weight:400;border-top:0}
.zone-table td.n{text-align:right;font-weight:700}
.toolbar{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.toolbar .field{font-size:18px;padding:11px;flex:1;min-width:180px}

nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:6;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.tabs-in{max-width:640px;margin:0 auto;display:flex}
.tabs button{flex:1;min-height:58px;border:0;background:none;font-weight:700;font-size:17px;color:var(--muted);cursor:pointer;border-top:3px solid transparent}
.tabs button[aria-selected="true"]{color:var(--accent);border-top-color:var(--accent)}

dialog{border:0;border-radius:16px;padding:0;width:min(520px,94vw);background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(10,12,20,.55)}
.dlg{padding:16px}
.dlg h3{margin:0 0 10px;font-size:20px}
.zone-opt{display:block;width:100%;text-align:left;padding:16px;margin-top:8px;border-radius:12px;border:2px solid var(--line);background:var(--bg);font-size:20px;font-weight:700;cursor:pointer}
.zone-opt[aria-current="true"]{border-color:var(--accent);background:var(--accent-soft)}
.dlg .actions{display:flex;gap:8px;margin-top:14px}
.dlg .actions .btn{flex:1}
.detail-line{display:flex;align-items:center;gap:8px;padding:9px 0;border-top:1px solid var(--line)}
.detail-line .main{flex:1;min-width:0;font-size:15px}
.detail-line .q{font-weight:700;font-size:19px}
.small-btn{min-height:40px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);cursor:pointer;font-weight:700}
.admin{margin-top:8px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px}
.admin p{margin:0 0 8px;font-size:15px;color:var(--muted)}
.chip-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:6px 6px 6px 12px;border-radius:999px;border:1px solid var(--line);background:var(--bg);font-weight:700}
.chip button{border:0;background:var(--surface);border-radius:50%;width:28px;height:28px;cursor:pointer;font-size:16px;line-height:1}
.chart{display:flex;align-items:flex-end;gap:6px;height:170px;padding:12px 12px 0;overflow-x:auto}
.bar{flex:1 0 34px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%}
.bar .v{font-size:13px;font-weight:700;margin-bottom:3px}
.bar .b{width:100%;background:var(--accent);border-radius:6px 6px 0 0;min-height:2px}
.bar .d{font-size:12px;color:var(--muted);padding:5px 0 8px}
.bar.sel .b{background:var(--ink)}
.prog{height:14px;border-radius:999px;background:var(--bg);border:1px solid var(--line);overflow:hidden;margin-top:8px}
.prog i{display:block;height:100%;background:var(--ok)}
.switch{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:15px}
.switch input{width:22px;height:22px}
@media (prefers-reduced-motion:no-preference){.flash{animation:pop .18s ease-out}@keyframes pop{from{transform:scale(.97);opacity:.4}to{transform:none;opacity:1}}}
</style>
</head>
<body>
<header class="top">
  <div class="top-in">
    <button class="zone-btn" id="zoneBtn" type="button" aria-haspopup="dialog">
      <span><small>Zona de conteo</small><strong id="zoneName">Elegí una zona</strong></span>
      <span class="chev" aria-hidden="true">▾</span>
    </button>
    <button class="status" id="status" type="button" style="border:0;background:none;cursor:pointer"><span class="dot"></span><span id="statusText">Conectando…</span><br><span id="userName" style="font-weight:700;color:var(--ink)"></span></button>
  </div>
</header>

<main class="wrap">
  <div id="bannerArea"></div>

  <!-- CONTAR -->
  <section id="view-contar">
    <div class="scan">
      <label for="scanInput">Código de barra</label>
      <input id="scanInput" class="field" autocomplete="off" autocapitalize="characters" spellcheck="false" enterkeyhint="next" placeholder="Escaneá o escribí el código">
      <div class="hint" id="scanHint">El catálogo se está cargando…</div>
    </div>

    <div id="itemCard" class="item hidden" aria-live="polite">
      <div class="code" id="itCode"></div>
      <div class="desc" id="itDesc"></div>
      <div class="tags" id="itTags"></div>
      <div class="prev" id="itPrev"></div>
      <div class="qty-row">
        <button class="step" type="button" id="qMinus" aria-label="Restar uno">−</button>
        <input id="qtyInput" class="field" type="number" inputmode="numeric" min="1" step="1" value="1" aria-label="Cantidad" enterkeyhint="done">
        <button class="step" type="button" id="qPlus" aria-label="Sumar uno">+</button>
      </div>
      <button class="btn primary" type="button" id="saveBtn">Guardar conteo</button>
      <button class="btn ghost" type="button" id="cancelBtn" style="width:100%;margin-top:8px">Cancelar</button>
    </div>
    <div id="flash"></div>

    <h2>Mis últimas capturas</h2>
    <div class="list" id="sessionList"><div class="empty">Todavía no guardaste conteos en esta sesión.</div></div>
    <label class="switch"><input type="checkbox" id="kbToggle"> Ocultar el teclado en pantalla al escanear (para PDT con lector)</label>
  </section>

  <!-- RESUMEN -->
  <section id="view-resumen" class="hidden">
    <div class="stats">
      <div class="stat"><b id="stCodes">0</b><span>códigos contados</span></div>
      <div class="stat"><b id="stUnits">0</b><span>unidades</span></div>
      <div class="stat"><b id="stNf">0</b><span>códigos fuera del catálogo</span></div>
      <div class="stat"><b id="stPeople">0</b><span>personas contando</span></div>
    </div>

    <h2>Por zona</h2>
    <div class="list"><table class="zone-table" id="zoneTable"></table></div>

    <h2>Artículos contados</h2>
    <div class="toolbar">
      <input id="searchInput" class="field" placeholder="Buscar por código o descripción" autocomplete="off">
      <select id="filterSel" class="field" style="flex:0 1 190px" aria-label="Filtro">
        <option value="all">Todos</option>
        <option value="nf">Fuera del catálogo</option>
        <option value="multi">En varias zonas</option>
      </select>
    </div>
    <div class="list" id="sumList" style="margin-top:10px"></div>
    <div class="hint" id="sumMore"></div>

    <button class="btn primary" type="button" id="exportBtn">Descargar Excel del inventario</button>
    <div class="hint" id="exportHint"></div>

    <button class="btn ghost" type="button" id="adminUnlock" style="width:100%;margin-top:18px">Administrar</button>
    <div id="adminArea" class="hidden">
      <h2>Administración</h2>
      <div class="admin">
        <p>Zonas disponibles para contar</p>
        <div class="chip-row" id="zoneChips"></div>
        <div class="toolbar" style="margin-top:0">
          <input id="newZone" class="field" placeholder="Nueva zona (ej. Vitrina joyería)" autocomplete="off">
          <button class="btn ghost" type="button" id="addZoneBtn">Agregar</button>
        </div>
      </div>
      <div class="admin">
        <p>Personas que cuentan</p>
        <div class="chip-row" id="userChips"></div>
        <div class="toolbar" style="margin-top:0">
          <input id="newUser" class="field" placeholder="Nombre (ej. Sadia)" autocomplete="off">
          <button class="btn ghost" type="button" id="addUserBtn">Agregar</button>
        </div>
      </div>
      <div class="admin">
        <p id="catInfo">Catálogo</p>
        <p>Para actualizarlo, subí juntos los Excel de Switch: creación de artículos y talla y color.</p>
        <input type="file" id="catFiles" accept=".xlsx,.xls" multiple>
        <div class="hint" id="catMsg"></div>
      </div>
      <div class="admin">
        <p>Borrar todos los conteos para empezar un inventario nuevo. Descargá el Excel antes.</p>
        <button class="btn danger" type="button" id="resetBtn">Borrar todos los conteos</button>
      </div>
    </div>
  </section>
  <!-- AVANCE (solo administración) -->
  <section id="view-avance" class="hidden">
    <div class="item" style="margin-top:14px">
      <div class="code">Avance del inventario</div>
      <div class="desc" id="avPct">0%</div>
      <div class="hint" id="avSub" style="margin-top:0"></div>
      <div class="prog"><i id="avBar" style="width:0%"></i></div>
    </div>
    <div class="stats">
      <div class="stat"><b id="avToday">0</b><span>códigos nuevos hoy</span></div>
      <div class="stat"><b id="avAvg">0</b><span>promedio por día</span></div>
      <div class="stat"><b id="avDays">0</b><span>días trabajados</span></div>
      <div class="stat"><b id="avEta">–</b><span>días restantes (al ritmo de los últimos 3)</span></div>
    </div>

    <h2>Códigos nuevos por día</h2>
    <div class="list"><div class="chart" id="avChart"></div></div>
    <div class="hint">Tocá una barra para ver el detalle de ese día.</div>

    <h2 id="avDayTitle">Detalle del día</h2>
    <div class="list"><table class="zone-table" id="avPeople"></table></div>
    <div class="list" style="margin-top:10px"><table class="zone-table" id="avZones"></table></div>

    <h2>Por día</h2>
    <div class="list"><table class="zone-table" id="avDaysTable"></table></div>

    <h2>Avance por zona</h2>
    <div class="list"><table class="zone-table" id="avZoneTotal"></table></div>

    <button class="btn primary" type="button" id="avExport">Descargar Excel de avance</button>
    <div class="hint" id="avHint"></div>
  </section>
</main>

<nav class="tabs" aria-label="Secciones">
  <div class="tabs-in" role="tablist">
    <button role="tab" aria-selected="true" data-view="contar">Contar</button>
    <button role="tab" aria-selected="false" data-view="resumen">Resumen</button>
    <button role="tab" aria-selected="false" data-view="avance" id="tabAvance" class="hidden">Avance</button>
  </div>
</nav>

<dialog id="zoneDlg"><div class="dlg"><h3>¿En qué zona estás contando?</h3><div id="zoneOpts"></div>
  <div class="actions"><button class="btn ghost" type="button" data-close>Cerrar</button></div></div></dialog>

<dialog id="userDlg"><div class="dlg"><h3>¿Quién está contando?</h3><div id="userOpts"></div>
  <div class="toolbar"><input id="userFree" class="field" placeholder="O escribí tu nombre" autocomplete="off"><button class="btn ghost" type="button" id="userFreeBtn">Usar</button></div>
</div></dialog>

<dialog id="pinDlg"><div class="dlg"><h3>Clave de administración</h3>
  <input id="pinInput" class="field" type="password" inputmode="numeric" autocomplete="off">
  <div class="hint" id="pinMsg"></div>
  <div class="actions"><button class="btn ghost" type="button" data-close>Cancelar</button><button class="btn primary" style="margin-top:0" type="button" id="pinGo">Entrar</button></div>
</div></dialog>

<dialog id="editDlg"><div class="dlg">
  <h3 id="edTitle">Corregir conteo</h3>
  <div class="hint" id="edSub"></div>
  <div class="qty-row"><input id="edQty" class="field" type="number" inputmode="numeric" min="0" step="1" aria-label="Cantidad total"></div>
  <div class="hint">Escribí la cantidad total correcta. Con 0 se elimina la línea.</div>
  <div class="actions"><button class="btn ghost" type="button" data-close>Cancelar</button><button class="btn primary" style="margin-top:0" type="button" id="edSave">Guardar corrección</button></div>
</div></dialog>

<dialog id="detailDlg"><div class="dlg">
  <h3 id="dtTitle"></h3><div class="hint" id="dtSub"></div>
  <div id="dtLines" style="margin-top:8px"></div>
  <div class="actions"><button class="btn ghost" type="button" data-close>Cerrar</button></div>
</div></dialog>

<dialog id="resetDlg"><div class="dlg">
  <h3>Borrar todos los conteos</h3>
  <p class="hint">Se eliminan los conteos de todas las personas y zonas. No se puede deshacer. Escribí BORRAR para confirmar.</p>
  <input id="resetConfirm" class="field" autocomplete="off">
  <div class="actions"><button class="btn ghost" type="button" data-close>Cancelar</button><button class="btn danger" type="button" id="resetGo">Borrar</button></div>
</div></dialog>

<script>
/* =====================================================================
   CONFIGURACIÓN — reemplazar con los datos del proyecto de Firebase
   (Consola de Firebase > Configuración del proyecto > Tus apps > Web)
   ===================================================================== */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyAWt7DUZgU4gwasJRGpF6x-ZV5zBH8hTgk",
  authDomain: "toma-de-inventario-coketass.firebaseapp.com",
  projectId: "toma-de-inventario-coketass",
  storageBucket: "toma-de-inventario-coketass.firebasestorage.app",
  messagingSenderId: "627670910521",
  appId: "1:627670910521:web:243b5fa13d34eb55ed2fe8"
};
const ADMIN_PIN = "2580";            // clave para entrar a Administrar
const INVENTARIO = "coketass";        // nombre del inventario (separa datos si usás el mismo Firebase para otro cliente)
/* ===================================================================== */

(function(){
const $=id=>document.getElementById(id);
const DEFAULT_ZONES=["PB-1","PB-2","P2-1","P2-2","P2-3"];
const S={fs:null,root:null,me:ls("inv_usuario")||null,admin:false,
  catalog:new Map(),catDocs:{},zones:DEFAULT_ZONES.slice(),users:[],
  zone:ls("inv_zona")||null,docs:new Map(),countsReady:false,session:[],current:null,pendingServer:false};

function ls(k,v){try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}}
const slug=s=>String(s).normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^A-Za-z0-9]+/g,"-").replace(/^-|-$/g,"").toLowerCase()||"x";
const keyOf=b=>"k"+Array.from(new TextEncoder().encode(b)).map(x=>x.toString(16).padStart(2,"0")).join("");
const today=()=>{const d=new Date();return d.getFullYear()+String(d.getMonth()+1).padStart(2,"0")+String(d.getDate()).padStart(2,"0")};
const fmt=n=>Number(n||0).toLocaleString("es-PA");
const tsOf=t=>t&&t.toMillis?t.toMillis():(typeof t==="number"?t:0);
const time=t=>{const m=tsOf(t);return m?new Date(m).toLocaleString("es-PA",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):""};
const norm=s=>String(s||"").trim().toUpperCase();
function esc(s){const d=document.createElement("div");d.textContent=s==null?"":String(s);return d.innerHTML}

/* ---------- UI ---------- */
function setStatus(kind,text){$("status").className="status "+(kind||"");$("statusText").textContent=text}
function refreshStatus(){
