const col=name=>S.root.collection(name);
function docIdFor(){return slug(S.me)+"__"+slug(S.zone)+"__"+today()}
function errText(e){
  const c=e&&e.code;
  if(c==="permission-denied")return "Firebase rechazó el guardado (permisos). Revisá las reglas de Firestore y que la autenticación anónima esté activa.";
  if(c==="resource-exhausted")return "Se alcanzó el límite de uso de Firebase por hoy.";
  return "No se pudo guardar: "+(e&&e.message||"error desconocido");
}
function save(){
  const c=S.current;if(!c)return;
  const q=parseInt($("qtyInput").value,10);
  if(!(q>0)){flash("bad","La cantidad tiene que ser 1 o más.");$("qtyInput").focus();return}
  if(!S.root){flash("bad","Todavía no hay conexión con la base. Revisá la configuración de Firebase.");return}
  if(!S.me){openUserDlg();return} if(!S.zone){openZoneDlg();return}
  const docId=docIdFor(),k=keyOf(norm(c.code));
  const body={u:S.me,z:S.zone,f:today(),items:{[k]:{b:c.code,q:firebase.firestore.FieldValue.increment(q),t:firebase.firestore.FieldValue.serverTimestamp()}}};
  if(!c.found)body.items[k].nf=1;
  const entry={code:c.code,desc:c.found?c.desc:"Fuera del catálogo",qty:q,zone:S.zone,docId,t:Date.now(),state:"pending"};
  S.session.unshift(entry);S.session=S.session.slice(0,25);
  col("conteos").doc(docId).set(body,{merge:true})
    .then(()=>{entry.state="ok";renderSession()},e=>{entry.state="error";renderSession();flash("bad",errText(e))});
  // con persistencia offline el cambio queda guardado en el equipo al instante y se sube cuando haya señal
  renderSession();flash("ok","Guardado: "+q+" × "+(c.found?c.desc:c.code));
  S.current=null;renderCurrent();focusScan();
}
function renderSession(){
  const box=$("sessionList");
  if(!S.session.length){box.innerHTML='<div class="empty">Todavía no guardaste conteos en esta sesión.</div>';return}
  box.innerHTML="";
  S.session.forEach(e=>{
    const b=document.createElement("button");b.type="button";b.className="row"+(e.state!=="ok"?" pending":"");
    const st=e.state==="pending"?(navigator.onLine?"subiendo…":"guardado en el equipo, se sube con señal"):e.state==="error"?"no se guardó":new Date(e.t).toLocaleTimeString("es-PA",{hour:"2-digit",minute:"2-digit"});
    b.innerHTML='<div class="main"><div class="t1">'+esc(e.desc)+'</div><div class="t2">'+esc(e.code)+' · '+esc(e.zone)+' · '+st+'</div></div><div class="q">+'+fmt(e.qty)+'</div>';
    b.onclick=()=>openEdit(e.docId,e.code,S.docs.get(e.docId),e.desc);
    box.appendChild(b)});
}

