/* ---------- captura ---------- */
function lookup(code){
  const c=norm(code);if(!c)return null;const hit=S.catalog.get(c);
  return {code:String(code).trim(),found:!!hit,desc:hit?hit[0]:"",art:hit?hit[1]:"",talla:hit?hit[2]:"",color:hit?hit[3]:""};
}
function countsFor(code){
  const k=keyOf(norm(code));let mine=0;const zones={};
  S.docs.forEach(d=>{const it=d.items&&d.items[k];if(!it||!(it.q>0))return;zones[d.z]=(zones[d.z]||0)+it.q;
    if(d.u===S.me&&d.z===S.zone)mine+=it.q});
  return {mine,zones};
}
function onScan(){
  const raw=$("scanInput").value.trim();if(!raw)return;
  if(!S.me){openUserDlg();return} if(!S.zone){openZoneDlg();return}
  S.current=lookup(raw);$("scanInput").value="";renderCurrent();
  $("qtyInput").value="1";setTimeout(()=>{$("qtyInput").focus();$("qtyInput").select()},20);
}
function renderCurrent(){
  const c=S.current,card=$("itemCard");
  if(!c){card.classList.add("hidden");return}
  card.classList.remove("hidden");card.classList.toggle("nf",!c.found);
  $("itCode").textContent=c.code+(c.art&&c.art!==c.code?"  ·  Artículo "+c.art:"");
  $("itDesc").textContent=c.found?c.desc:"Código fuera del catálogo";
  $("itTags").innerHTML=(c.talla?'<span class="tag">Talla '+esc(c.talla)+'</span>':"")+(c.color?'<span class="tag">'+esc(c.color)+'</span>':"")+(!c.found?'<span class="tag">Se guarda igual y queda marcado para revisar</span>':"");
  const k=countsFor(c.code);const parts=[];
  if(k.mine)parts.push("Ya contaste <b>"+fmt(k.mine)+"</b> en "+esc(S.zone)+"; se va a sumar.");
  const others=Object.entries(k.zones).filter(([z])=>z!==S.zone);
  if(others.length)parts.push("También contado en: "+others.map(([z,q])=>esc(z)+" ("+fmt(q)+")").join(", ")+".");
  $("itPrev").innerHTML=parts.join(" ");
}
$("scanInput").addEventListener("keydown",e=>{if((e.key==="Enter"||e.key==="Tab")&&$("scanInput").value.trim()){e.preventDefault();onScan()}});
$("qtyInput").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();save()}});
