};

/* ---------- resumen ---------- */
function aggregate(){
  const map=new Map(),people=new Set(),zoneTot={};
  S.docs.forEach((d,id)=>{
    if(!d.items)return;let any=false;
    for(const k in d.items){const it=d.items[k];if(!(it&&it.q>0))continue;any=true;
      const code=it.b;const nc=norm(code);let r=map.get(nc);
      if(!r){const h=S.catalog.get(nc);r={code,desc:h?h[0]:"",art:h?h[1]:"",talla:h?h[2]:"",color:h?h[3]:"",nf:!h,total:0,zones:{},lines:[],last:0};map.set(nc,r)}
      r.total+=it.q;r.zones[d.z]=(r.zones[d.z]||0)+it.q;r.lines.push({docId:id,d,q:it.q,t:it.t});r.last=Math.max(r.last,tsOf(it.t)||Date.now());
      zoneTot[d.z]=zoneTot[d.z]||{codes:new Set(),units:0};zoneTot[d.z].codes.add(nc);zoneTot[d.z].units+=it.q;}
    if(any)people.add(d.u)});
  return {map,people,zoneTot};
}
let sumTimer=null;
function scheduleSummary(){clearTimeout(sumTimer);if(view==="resumen")sumTimer=setTimeout(renderSummary,250);else if(view==="avance")sumTimer=setTimeout(renderAvance,300)}
