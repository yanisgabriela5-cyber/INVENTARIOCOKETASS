/* ---------- avance diario ---------- */
let avSel=null;
const dLabel=f=>f.slice(6,8)+"/"+f.slice(4,6);
function avanceData(){
  const first=new Map(),days={},people={},zones={};
  S.docs.forEach(d=>{if(!d.items)return;
    for(const k in d.items){const it=d.items[k];if(!(it&&it.q>0))continue;const nc=norm(it.b);
      const prev=first.get(nc);if(!prev||d.f<prev)first.set(nc,d.f);
      const D=days[d.f]=days[d.f]||{units:0,codes:new Set(),nuevos:0,people:{},zones:{}};
      D.units+=it.q;D.codes.add(nc);
      const P=D.people[d.u]=D.people[d.u]||{units:0,codes:new Set()};P.units+=it.q;P.codes.add(nc);
      const Z=D.zones[d.z]=D.zones[d.z]||{units:0,codes:new Set()};Z.units+=it.q;Z.codes.add(nc);
      const ZT=zones[d.z]=zones[d.z]||{units:0,codes:new Set()};ZT.units+=it.q;ZT.codes.add(nc);}});
  let inCat=0;first.forEach((f,nc)=>{days[f].nuevos++;const h=S.catalog.get(nc);if(h&&!h[4])inCat++});
  const order=Object.keys(days).sort();
  return {first,days,order,zones,inCat};
}
function renderAvance(){
  if(!S.admin)return;
  const A=avanceData(),tot=S.countable||0,pct=tot?Math.min(100,A.inCat/tot*100):0,t=today();
  $("avPct").textContent=pct.toFixed(1)+"%";$("avBar").style.width=pct+"%";
  $("avSub").textContent=fmt(A.inCat)+" de "+fmt(tot)+" códigos del catálogo contados · faltan "+fmt(Math.max(0,tot-A.inCat))+(A.first.size>A.inCat?" · "+fmt(A.first.size-A.inCat)+" fuera del catálogo":"");
  const nuevos=A.order.map(f=>A.days[f].nuevos);
  $("avToday").textContent=fmt(A.days[t]?A.days[t].nuevos:0);
  $("avDays").textContent=fmt(A.order.length);
  $("avAvg").textContent=fmt(A.order.length?Math.round(nuevos.reduce((a,b)=>a+b,0)/A.order.length):0);
  const last3=nuevos.slice(-3),rate=last3.length?last3.reduce((a,b)=>a+b,0)/last3.length:0,left=Math.max(0,tot-A.inCat);
  $("avEta").textContent=!left?"0":rate>0?fmt(Math.ceil(left/rate)):"–";
  const max=Math.max(1,...nuevos);if(!avSel||!A.days[avSel])avSel=A.order[A.order.length-1]||null;
  const ch=$("avChart");ch.innerHTML=A.order.length?"":'<div class="empty">Todavía no hay conteos.</div>';
  A.order.forEach((f,i)=>{const b=document.createElement("button");b.type="button";b.className="bar"+(f===avSel?" sel":"");b.style.border="0";b.style.background="none";b.style.cursor="pointer";
    b.innerHTML='<span class="v">'+fmt(nuevos[i])+'</span><span class="b" style="height:'+Math.round(nuevos[i]/max*110)+'px"></span><span class="d">'+dLabel(f)+'</span>';
    b.onclick=()=>{avSel=f;renderAvance()};ch.appendChild(b)});
  ch.scrollLeft=ch.scrollWidth;
  const D=avSel&&A.days[avSel];
  $("avDayTitle").textContent="Detalle del "+(avSel?dLabel(avSel)+(avSel===t?" (hoy)":""):"día");
  $("avPeople").innerHTML='<tr><th>Persona</th><th style="text-align:right">Códigos</th><th style="text-align:right">Unidades</th></tr>'+
    (D?Object.entries(D.people).sort((a,b)=>b[1].codes.size-a[1].codes.size).map(([u,v])=>'<tr><td>'+esc(u)+'</td><td class="n">'+fmt(v.codes.size)+'</td><td class="n">'+fmt(v.units)+'</td></tr>').join(""):'<tr><td colspan="3">Sin conteos</td></tr>');
  $("avZones").innerHTML='<tr><th>Zona</th><th style="text-align:right">Códigos</th><th style="text-align:right">Unidades</th></tr>'+
    (D?Object.entries(D.zones).sort().map(([z,v])=>'<tr><td>'+esc(z)+'</td><td class="n">'+fmt(v.codes.size)+'</td><td class="n">'+fmt(v.units)+'</td></tr>').join(""):'');
  let acc=0;
  $("avDaysTable").innerHTML='<tr><th>Día</th><th style="text-align:right">Nuevos</th><th style="text-align:right">Unidades</th><th style="text-align:right">Acumulado</th></tr>'+
    A.order.map(f=>{acc+=A.days[f].nuevos;return [f,acc]}).reverse().map(([f,a])=>{const d=A.days[f];
      return '<tr><td>'+dLabel(f)+'</td><td class="n">'+fmt(d.nuevos)+'</td><td class="n">'+fmt(d.units)+'</td><td class="n">'+(tot?(a/tot*100).toFixed(1)+"%":fmt(a))+'</td></tr>'}).join("");
  const zs=Array.from(new Set(S.zones.concat(Object.keys(A.zones))));
  $("avZoneTotal").innerHTML='<tr><th>Zona</th><th style="text-align:right">Códigos</th><th style="text-align:right">Unidades</th></tr>'+
    zs.map(z=>{const v=A.zones[z];return '<tr><td>'+esc(z)+'</td><td class="n">'+fmt(v?v.codes.size:0)+'</td><td class="n">'+fmt(v?v.units:0)+'</td></tr>'}).join("");
}
$("avExport").onclick=()=>{
  if(typeof XLSX==="undefined"){$("avHint").textContent="No se cargó el generador de Excel. Recargá con señal.";return}
  const A=avanceData(),tot=S.countable||0;let acc=0;
  const dias=[["Fecha","Códigos nuevos","Unidades","Personas","Acumulado","% avance"]];
  A.order.forEach(f=>{const d=A.days[f];acc+=d.nuevos;dias.push([dLabel(f)+"/"+f.slice(0,4),d.nuevos,d.units,Object.keys(d.people).length,acc,tot?+(acc/tot*100).toFixed(1):""])});
  const per=[["Fecha","Persona","Zona","Códigos","Unidades"]];
  A.order.forEach(f=>{const d=A.days[f];S.docs.forEach(doc=>{if(doc.f!==f||!doc.items)return;let c=0,u=0;for(const k in doc.items){const it=doc.items[k];if(it&&it.q>0){c++;u+=it.q}}if(c)per.push([dLabel(f)+"/"+f.slice(0,4),doc.u,doc.z,c,u])})});
  const pend=[["Código Barra","Código Artículo","Descripción","Talla","Color"]];
  S.catalog.forEach((v,nc)=>{if(!v[4]&&!A.first.has(nc))pend.push([nc,v[1],v[0],v[2],v[3]])});
  const wb=XLSX.utils.book_new(),mk=(r,w)=>{const ws=XLSX.utils.aoa_to_sheet(r);ws["!cols"]=w.map(x=>({wch:x}));return ws};
  XLSX.utils.book_append_sheet(wb,mk(dias,[12,15,10,10,12,10]),"Avance por día");
  XLSX.utils.book_append_sheet(wb,mk(per,[12,18,10,10,10]),"Por persona y zona");
  const wp=mk(pend,[18,12,45,8,14]);const rg=XLSX.utils.decode_range(wp["!ref"]);for(let R=1;R<=rg.e.r;R++){const c=wp[XLSX.utils.encode_cell({r:R,c:0})];if(c){c.t="s";c.z="@"}}
  XLSX.utils.book_append_sheet(wb,wp,"Pendientes de contar");
  const name="avance_"+INVENTARIO+"_"+today()+".xlsx";XLSX.writeFile(wb,name);$("avHint").textContent="Descargado: "+name;
};

/* ---------- exportar ---------- */
