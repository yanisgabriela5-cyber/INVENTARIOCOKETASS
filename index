  const {map,people,zoneTot}=aggregate();
  let units=0,nf=0;map.forEach(r=>{units+=r.total;if(r.nf)nf++});
  $("stCodes").textContent=fmt(map.size);$("stUnits").textContent=fmt(units);$("stNf").textContent=fmt(nf);$("stPeople").textContent=fmt(people.size);
  const zs=Array.from(new Set(S.zones.concat(Object.keys(zoneTot))));
  $("zoneTable").innerHTML='<tr><th>Zona</th><th style="text-align:right">Códigos</th><th style="text-align:right">Unidades</th></tr>'+
    zs.map(z=>{const t=zoneTot[z];return '<tr><td>'+esc(z)+'</td><td class="n">'+fmt(t?t.codes.size:0)+'</td><td class="n">'+fmt(t?t.units:0)+'</td></tr>'}).join("");
  const q=norm($("searchInput").value),f=$("filterSel").value;
  let rows=Array.from(map.values());
  if(q)rows=rows.filter(r=>norm(r.code).includes(q)||norm(r.desc).includes(q)||norm(r.art).includes(q));
  if(f==="nf")rows=rows.filter(r=>r.nf);if(f==="multi")rows=rows.filter(r=>Object.keys(r.zones).length>1);
  rows.sort((a,b)=>b.last-a.last);
  const box=$("sumList");box.innerHTML="";
  if(!rows.length)box.innerHTML='<div class="empty">'+(map.size?"Ningún artículo coincide con la búsqueda.":"Todavía no hay conteos. Empezá desde la pestaña Contar.")+'</div>';
  rows.slice(0,150).forEach(r=>{
    const b=document.createElement("button");b.type="button";b.className="row";
    b.innerHTML='<div class="main"><div class="t1">'+esc(r.nf?"Fuera del catálogo":r.desc)+'</div><div class="t2">'+esc(r.code)+' · '+esc(Object.keys(r.zones).join(", "))+'</div></div><div class="q">'+fmt(r.total)+'</div>';
    b.onclick=()=>openDetail(r);box.appendChild(b)});
  $("sumMore").textContent=rows.length>150?"Mostrando 150 de "+fmt(rows.length)+". Usá la búsqueda para encontrar el resto; el Excel trae todo.":"";
  if(S.admin)renderAdmin();
}
