  if(typeof XLSX==="undefined"){$("exportHint").textContent="No se cargó el generador de Excel. Recargá la página con señal.";return}
  const {map}=aggregate();
  if(!map.size){$("exportHint").textContent="No hay conteos para descargar.";return}
  const zs=Array.from(new Set(S.zones.concat(...Array.from(map.values()).map(r=>Object.keys(r.zones)))));
  const cons=[["Código Barra","Código Artículo","Descripción","Talla","Color"].concat(zs,["Total"])];
  const det=[["Zona","Persona","Fecha","Código Barra","Código Artículo","Descripción","Cantidad","Última captura"]];
  const nfr=[["Código Barra","Cantidad","Zonas"]];
  Array.from(map.values()).sort((a,b)=>String(a.art||a.code).localeCompare(String(b.art||b.code))).forEach(r=>{
    cons.push([r.code,r.art,r.nf?"FUERA DEL CATÁLOGO":r.desc,r.talla,r.color].concat(zs.map(z=>r.zones[z]||0),[r.total]));
    r.lines.forEach(l=>det.push([l.d.z,l.d.u,l.d.f.slice(6,8)+"/"+l.d.f.slice(4,6)+"/"+l.d.f.slice(0,4),r.code,r.art,r.nf?"FUERA DEL CATÁLOGO":r.desc,l.q,time(l.t)]));
    if(r.nf)nfr.push([r.code,r.total,Object.keys(r.zones).join(", ")]);
  });
  const asText=(ws,c)=>{const rg=XLSX.utils.decode_range(ws["!ref"]);for(let R=1;R<=rg.e.r;R++){const x=ws[XLSX.utils.encode_cell({r:R,c})];if(x){x.t="s";x.v=String(x.v);x.z="@"}}};
  const mk=(rows,w,c)=>{const ws=XLSX.utils.aoa_to_sheet(rows);ws["!cols"]=w.map(x=>({wch:x}));asText(ws,c);return ws};
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,mk(cons,[18,12,45,8,14].concat(zs.map(()=>10),[9]),0),"Consolidado");
  XLSX.utils.book_append_sheet(wb,mk(det,[10,18,12,18,12,45,9,16],3),"Detalle por zona");
  XLSX.utils.book_append_sheet(wb,mk(nfr,[22,10,30],0),"Fuera del catálogo");
  const name="inventario_"+INVENTARIO+"_"+today()+".xlsx";
  XLSX.writeFile(wb,name);$("exportHint").textContent="Descargado: "+name;
};

/* ---------- administración ---------- */
function setAdmin(on){S.admin=on;ls("inv_admin",on?"1":"0");$("tabAvance").classList.toggle("hidden",!on);$("adminArea").classList.toggle("hidden",!on);
  $("adminUnlock").textContent=on?"Salir de administración":"Administrar";if(on)renderAdmin()}
$("adminUnlock").onclick=()=>{if(S.admin){setAdmin(false);return}
  $("pinInput").value="";$("pinMsg").textContent="";$("pinDlg").showModal();setTimeout(()=>$("pinInput").focus(),30)};
$("pinInput").addEventListener("keydown",e=>{if(e.key==="Enter")$("pinGo").click()});
$("pinGo").onclick=()=>{if($("pinInput").value===ADMIN_PIN){$("pinDlg").close();setAdmin(true);renderSummary()}
  else{$("pinMsg").textContent="Clave incorrecta.";$("pinInput").select()}};
function chips(box,list,onRemove){box.innerHTML="";list.forEach(z=>{const c=document.createElement("span");c.className="chip";c.innerHTML=esc(z);
  const x=document.createElement("button");x.type="button";x.setAttribute("aria-label","Quitar "+z);x.textContent="×";x.onclick=()=>onRemove(z);c.appendChild(x);box.appendChild(c)})}
function renderAdmin(){
  $("adminArea").classList.remove("hidden");
  chips($("zoneChips"),S.zones,z=>{if(S.zones.length>1)saveConfig({zonas:S.zones.filter(y=>y!==z)})});
  chips($("userChips"),S.users,u=>saveConfig({usuarios:S.users.filter(y=>y!==u)}));
  $("catInfo").textContent="Catálogo: "+fmt(S.catalog.size)+" códigos cargados.";
}
function saveConfig(patch){col("config").doc("general").set(patch,{merge:true}).catch(e=>flash("bad",errText(e)))}
$("addZoneBtn").onclick=()=>{const v=$("newZone").value.trim();if(v&&!S.zones.some(z=>norm(z)===norm(v)))saveConfig({zonas:S.zones.concat([v])});$("newZone").value=""};
$("addUserBtn").onclick=()=>{const v=$("newUser").value.trim();if(v&&!S.users.some(z=>norm(z)===norm(v)))saveConfig({usuarios:S.users.concat([v])});$("newUser").value=""};
$("resetBtn").onclick=()=>{$("resetConfirm").value="";$("resetDlg").showModal()};
$("resetGo").onclick=async()=>{
  if($("resetConfirm").value.trim().toUpperCase()!=="BORRAR"){$("resetConfirm").focus();return}
  $("resetDlg").close();
  try{const ids=Array.from(S.docs.keys());for(let i=0;i<ids.length;i+=400){const b=S.fs.batch();ids.slice(i,i+400).forEach(id=>b.delete(col("conteos").doc(id)));await b.commit()}
    S.session=[];renderSession();flash("ok","Conteos borrados.")}catch(e){flash("bad",errText(e))}
};
$("catFiles").onchange=async e=>{
  const files=Array.from(e.target.files||[]);if(!files.length)return;const msg=$("catMsg");msg.textContent="Leyendo archivos…";
  if(typeof XLSX==="undefined"){msg.textContent="No se cargó el lector de Excel. Recargá con señal.";return}
  const arts=[],vars=[];
  for(const f of files){const wb=XLSX.read(await f.arrayBuffer(),{type:"array"});const rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:"",raw:false});
    if(!rows.length)continue;const h=Object.keys(rows[0]);
    if(h.includes("Talla *")&&h.includes("Código Artículo *"))vars.push(...rows);else if(h.includes("Descripción *")&&h.includes("Código Barra *"))arts.push(...rows)}
  if(!arts.length){msg.textContent="Falta el Excel de creación de artículos (con la columna Descripción).";return}
  const desc={},items={},parents=new Set(vars.map(r=>String(r["Código Artículo *"]).trim()));
  arts.forEach(r=>{const code=String(r["Código *"]).trim(),bc=String(r["Código Barra *"]).trim();desc[code]=r["Descripción *"];if(bc)items[norm(bc)]=[r["Descripción *"],code,"","",parents.has(code)?1:0]});
  vars.forEach(r=>{const code=String(r["Código Artículo *"]).trim(),bc=String(r["Código Barra *"]).trim();if(!bc)return;
    const t=String(r["Talla *"]).trim(),c=String(r["Color *"]).trim();items[norm(bc)]=[desc[code]||"",code,t.toUpperCase()==="PLAIN"?"":t,c.toUpperCase()==="PLAIN"?"":c,0]});
  const keys=Object.keys(items),size=1500,n=Math.ceil(keys.length/size);
  try{msg.textContent="Guardando catálogo…";
    for(let i=0;i<n;i++){const part={};keys.slice(i*size,(i+1)*size).forEach(k=>part[keyOf(k)]=[k].concat(items[k]));await col("catalogo").doc("c"+String(i).padStart(2,"0")).set({items:part})}
    for(const id of Object.keys(S.catDocs)){if(parseInt(id.slice(1),10)>=n)await col("catalogo").doc(id).delete()}
    msg.textContent="Catálogo actualizado: "+fmt(keys.length)+" códigos."}
  catch(err){msg.textContent="No se pudo guardar el catálogo: "+errText(err)}
  e.target.value="";
};

/* ---------- conexión ---------- */
function rebuildCatalog(){
  const m=new Map();Object.values(S.catDocs).forEach(items=>{for(const k in items){const v=items[k];if(Array.isArray(v)&&v.length>=5)m.set(norm(v[0]),v.slice(1))}});
  S.catalog=m;S.countable=0;m.forEach(v=>{if(!v[4])S.countable++});
  $("scanHint").textContent=m.size?"Catálogo listo: "+fmt(m.size)+" códigos. El lector envía Enter y pasa a la cantidad.":"Catálogo vacío. Cargalo en Resumen > Administrar. Se puede contar igual.";
  renderCurrent();scheduleSummary();
}
async function init(){
  renderZone();renderSession();
  if(typeof firebase==="undefined"){setStatus("off","Sin conexión");banner("bad","No se pudo cargar Firebase. Abrí la página con señal al menos la primera vez.");return}
  if(String(FIREBASE_CONFIG.apiKey).includes("PEGAR")){setStatus("off","Sin configurar");banner("bad","Falta pegar la configuración de Firebase al inicio del archivo.");return}
  firebase.initializeApp(FIREBASE_CONFIG);
  S.fs=firebase.firestore();
  try{await S.fs.enablePersistence({synchronizeTabs:true})}catch(e){}
  try{await firebase.auth().signInAnonymously()}catch(e){banner("bad","No se pudo iniciar sesión en Firebase. Activá la autenticación anónima en la consola.");setStatus("off","Sin acceso");return}
  S.root=S.fs.collection("inventarios").doc(INVENTARIO);
  const loadTimer=setTimeout(()=>{if(!S.countsReady)banner("warn","Sin respuesta del servidor todavía. Revisá el WiFi; se conecta solo cuando vuelva la señal.")},10000);

  col("config").doc("general").onSnapshot(s=>{
    const d=s.exists?s.data():{};
    S.zones=Array.isArray(d.zonas)&&d.zonas.length?d.zonas.slice():DEFAULT_ZONES.slice();
    S.users=Array.isArray(d.usuarios)?d.usuarios.slice():[];
    if(S.zone&&!S.zones.includes(S.zone)){S.zone=null;renderZone()}
    if(S.admin)renderAdmin();
    if(!anyOpen()){if(!S.me)openUserDlg();else if(!S.zone)openZoneDlg()}
  },e=>banner("bad",errText(e)));

  col("catalogo").onSnapshot(snap=>{const docs={};snap.docs.forEach(d=>docs[d.id]=d.data().items||{});S.catDocs=docs;rebuildCatalog()},e=>banner("bad",errText(e)));

  col("conteos").onSnapshot({includeMetadataChanges:true},snap=>{
    const m=new Map();snap.docs.forEach(d=>m.set(d.id,d.data({serverTimestamps:"estimate"})));S.docs=m;
    S.pendingServer=snap.metadata.hasPendingWrites;
    if(!snap.metadata.fromCache){S.countsReady=true;clearTimeout(loadTimer);banner("")}
    if(!S.pendingServer)S.session.forEach(e=>{if(e.state==="pending")e.state="ok"});
    refreshStatus();renderSession();renderCurrent();scheduleSummary();
  },e=>{clearTimeout(loadTimer);setStatus("off","Desconectado");banner("bad",errText(e))});

  if(ls("inv_admin")==="1")setAdmin(true);
  if(!S.me)openUserDlg();else if(!S.zone)openZoneDlg();else focusScan();
}
document.addEventListener("visibilitychange",()=>{if(!document.hidden)focusScan()});
init();
})();
</script>
